# Copy this file to .env, then provide the MongoDB Atlas connection string.
MONGODB_URI=
MONGO_DATABASE_NAME=storelisten
REDIS_URL=redis://localhost:6379/0
REDIS_EVENT_BUS_ENABLED=false
JWT_SECRET=local-development-only-change-before-deploy
SESSION_SECRET=local-development-only-change-before-deploy

# Providers
AI_PROVIDER=mock
AI_API_KEY=
# Set AI_PROVIDER=gemini and add a Google AI Studio key to enable conversation reports.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SPEECH_PROVIDER=whisper
SPEECH_API_KEY=
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_TRANSLATE_SPANISH=false
POS_PROVIDER=mock
POS_API_KEY=
STORAGE_PROVIDER=local

# App
APP_ENV=development
DEBUG=false
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Set this only when building a desktop release for a deployed HTTPS API.
# STORE_LISTEN_API_BASE_URL=https://api.yourdomain.com

# Retention
AUDIO_RETENTION_DAYS=7
AUDIO_STORAGE_DIR=./storage/audio
TRANSCRIPT_RETENTION_DAYS=30

# Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120

# Demo defaults
DEMO_MODE=true

