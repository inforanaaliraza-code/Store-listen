# Copy this file to .env, then provide the MongoDB Atlas connection string.
MONGODB_URI=
MONGO_DATABASE_NAME=storelisten
JWT_SECRET=local-development-only-change-before-deploy

# Providers (keep all secrets on the Node server; never put them in VITE_* variables)
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com
POS_PROVIDER=none
STORAGE_PROVIDER=gridfs

# App
APP_ENV=development
# Vite frontend values are in frontend/.env.example (VITE_API_URL and VITE_WS_URL).

# Set this only when building a desktop release for a deployed HTTPS API.
# STORE_LISTEN_API_BASE_URL=https://api.yourdomain.com

# Retention
AUDIO_RETENTION_DAYS=7
AUDIO_STORAGE_DIR=./storage/audio
TRANSCRIPT_RETENTION_DAYS=30

# Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live-only mode; local tests may explicitly enable demo fixtures.
DEMO_MODE=false
