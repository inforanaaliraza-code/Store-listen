{
  "name": "store-listen-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "desktop:dev": "npm --prefix desktop-agent start",
    "desktop:dist": "npm --prefix desktop-agent run dist",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "test:desktop": "npm --prefix desktop-agent test",
    "lint": "npm run lint --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
